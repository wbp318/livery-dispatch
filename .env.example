# Livery Dispatch — environment configuration
# Copy to .env and fill in real values for production-like runs.
# Variables marked PROD-REQUIRED are gated by the boot-time check in
# app.py (v1.0.3). Setting DISPATCH_ENV=production without them refuses
# to start.

# --- Runtime mode ---
# Set to "production" to enable HSTS, secure cookies, the boot-time
# fail-closed config check, and to refuse permissive CORS / console
# notifications. Default (unset) is dev.
DISPATCH_ENV=

# --- Database ---
# SQLite for MVP. Switch to postgresql://... for production.
DATABASE_URL=sqlite:///./dispatch.db

# --- Notifications ---
# "console" prints SMS bodies + phone numbers to stdout — DEV ONLY.
# Production must use "twilio" (boot guard refuses console in production).
NOTIFICATION_PROVIDER=console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=                  # PROD-REQUIRED when NOTIFICATION_PROVIDER=twilio
TWILIO_FROM_NUMBER=
# Twilio webhook signature verification — set "false" only for local testing.
TWILIO_VALIDATE_SIGNATURE=true

# --- Voice routing ---
DISPATCHER_PHONE=                   # E.164 number that inbound calls dial through to
QUIET_HOURS_ENABLED=true
QUIET_HOURS_START=02:00             # 6pm–2am is PEAK; only 2am–8am is "quiet"
QUIET_HOURS_END=08:00
QUIET_HOURS_TIMEZONE=America/New_York

# --- CORS ---
# PROD-REQUIRED: must be pinned to specific origin(s), no wildcards.
# Comma-separated list, e.g. "https://example.com,https://www.example.com"
CORS_ORIGINS=*

# --- Admin auth ---
# Generate a password hash: python -c "from admin_auth import hash_password; print(hash_password('yourpass'))"
# Generate a session secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_USERNAME=admin                # PROD-REQUIRED
ADMIN_PASSWORD_HASH=                # PROD-REQUIRED (bcrypt format)
ADMIN_SESSION_SECRET=               # PROD-REQUIRED (>= 32 chars)

# --- Driver surface ---
# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
DRIVER_CSRF_SECRET=                 # PROD-REQUIRED (>= 32 chars)

# --- Rate limiting ---
# Public form bucket (shared by /reservations, /inquiries, /quote).
PUBLIC_FORM_RATE_LIMIT_ENABLED=true
PUBLIC_FORM_RATE_WINDOW_S=60
PUBLIC_FORM_RATE_MAX=5
# Login bucket (separate from public form bucket, see v1.0.4).
LOGIN_RATE_LIMIT_ENABLED=true
LOGIN_RATE_WINDOW_S=60
LOGIN_RATE_MAX=10

# --- Request-size cap (v1.4.1) ---
# Largest request body accepted, in bytes; bigger ones get a 413 before
# anything reads them. Unset = 32768. Production refuses to boot on a value
# that isn't a whole number of at least 1024.
# MAX_REQUEST_BYTES=32768

# --- Backups (v1.4.1) ---
# boot.py copies an existing SQLite database to backups/ beside it before
# migrating it, and refuses to migrate if it can't. Set this only to migrate
# without the copy on purpose (a full volume you can't free in time).
# SKIP_PRE_MIGRATION_BACKUP=1

# --- Dispatch tuning ---
BROADCAST_FANOUT=3
BROADCAST_RADIUS_MI=50
OVERFLOW_FANOUT=5
# (ACCEPT_WINDOW_SECONDS was listed here until v1.1.18 but no code ever read
# it. Offers don't auto-expire: the dispatcher times them and re-broadcasts or
# hands off to overflow. See GUIDE.md § 7.)

# --- Proxy posture (v1.1.17; both REQUIRED when DISPATCH_ENV=production) ---
# Public https origin Twilio calls; webhook signatures are verified against it
# (behind a TLS-terminating proxy the app otherwise sees http:// and 403s).
# PUBLIC_BASE_URL=https://dispatch.example.com
# Header your edge proxy SETS to the real client IP, used as the per-IP
# rate-limit key. Fly.io: Fly-Client-IP. Nothing in front of uvicorn: none.
# CLIENT_IP_HEADER=Fly-Client-IP

# --- Routing (fare distance + map geometry) ---
# "osrm" uses road-network routing; "haversine" is great-circle fallback.
FARE_DISTANCE_PROVIDER=osrm
# One OSRM for BOTH fare distance and the browser maps' /osrm proxy (v1.1.15).
# Default is the public demo (non-commercial only, ~1 req/s, no SLA) — fine
# for dev. Production: the self-hosted corridor image, see osrm/README.md
# (e.g. http://livery-osrm.flycast). Empty string disables routing
# (maps keep straight lines; set FARE_DISTANCE_PROVIDER=haversine too).
OSRM_BASE_URL=https://router.project-osrm.org
OSRM_TIMEOUT_S=5
# /osrm proxy cache + per-IP limit (own bucket, separate from public forms).
OSRM_PROXY_CACHE_TTL_S=86400
OSRM_PROXY_CACHE_MAX=512
OSRM_PROXY_RATE_LIMIT_ENABLED=true
OSRM_PROXY_RATE_WINDOW_S=60
OSRM_PROXY_RATE_MAX=60

# --- Map tiles (v1.3.0) ---
# https origin of our own map server (QGIS Server, gis/server/README.md),
# e.g. https://livery-maps.fly.dev. /map draws its basemap and the CSP
# allows it. Unset: OpenStreetMap's standard tiles, darkened in the browser
# (production logs a warning). Plain http only for localhost.
# MAP_SERVER_URL=

# --- Web push notifications (v1.1.0) ---
# Feature flag — default "false". When false, broadcasts always go via SMS
# (current behavior). When true, drivers with an active push subscription
# receive push instead of SMS; drivers without a subscription still get SMS.
# Flip to "true" only after the live phone smoke test confirms the PWA
# accept/decline + status walk feels right in the chauffeur's hand.
PUSH_NOTIFICATIONS_ENABLED=false
# VAPID credentials are PROD-REQUIRED when PUSH_NOTIFICATIONS_ENABLED=true.
# Generate a keypair with:
#   python -c "from py_vapid import Vapid; v = Vapid(); v.generate_keys(); \
#     print('PRIVATE:', v.private_pem().decode()); \
#     print('PUBLIC:',  v.public_key.public_bytes_raw().hex())"
# Or use vapid CLI: pip install py-vapid && vapid --gen
# Public key is what the browser uses in pushManager.subscribe(); private
# key signs each outbound push to the push service.
VAPID_PRIVATE_KEY=
VAPID_PUBLIC_KEY=
# Required by the VAPID spec — pushed to the push service as a Subject claim.
# Use mailto: or https: URL.
VAPID_CONTACT_EMAIL=mailto:desk@example.com
